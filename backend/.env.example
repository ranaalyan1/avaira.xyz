# ─── CORE ────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/ or https://anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=avaira_v2

# Security
# Run 'python scripts/generate_secrets.py' to generate these
AVAIRA_LOG_SECRET=default_secret_32_bytes_long_!!!!!
AVAIRA_ADMIN_KEY=your_admin_secret_here

# Slashing
SLASH_BASE_PENALTY_USD=10

# ─── OPTIONAL: STRIPE (Financial Slashing) ────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── OPTIONAL: WEB3 (Reputation Anchoring) ────────────────────────
AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
PROTOCOL_PRIVATE_KEY=
AGENT_REGISTRY_ADDRESS=
EXECUTION_WALLET_ADDRESS=
FREEZE_SLASH_ADDRESS=
TREASURY_ADDRESS=
REPUTATION_ENGINE_ADDRESS=

# ─── AUTH (Google/X) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8001/api/auth/x/callback

PERMIT_SECRET=keep_this_safe_for_legacy_permits
ADMIN_EMAILS=admin@avaira.xyz

# ─── OPTIONAL: CONTACT FORM EMAIL NOTIFICATIONS ──────────────────
# POST /api/contact stores every message; when these are set it also emails
# the team inbox. Leave SMTP_HOST empty to disable sending (messages are
# still stored and logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@avaira.xyz
SMTP_USE_TLS=true
CONTACT_NOTIFY_EMAIL=team@avaira.xyz
