# Avaira on Monad — deployment configuration.
# Copy to `contracts/.env` and fill in. `contracts/.env` is gitignored: never commit keys.
#
# Foundry loads this file automatically for `forge script`, `forge test` and `forge verify-contract`.
# The Makefile targets in this directory also `source` it, so plain `make deploy-monad` works.

# ── Required ──────────────────────────────────────────────────────────────────
# A funded Monad testnet wallet. Get MON from the faucet at https://testnet.monad.xyz
# (or `cast wallet new` to generate a fresh key first).
DEPLOYER_PRIVATE_KEY=0x_your_funded_monad_testnet_key

# ── Network (defaults are the public endpoints; override for a private provider) ──
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz

# ── Verification ──────────────────────────────────────────────────────────────
# Optional. Without it, scripts/verify-monad.sh uses Sourcify (no key required).
# Monadscan API keys: https://testnet.monadscan.com → sign in → API Keys.
MONADSCAN_API_KEY=

# ── Protocol configuration (all optional, defaults shown) ─────────────────────
# Protocol admin and slash/forfeit recipient. Defaults to the deployer.
ADMIN=
TREASURY=

# ERC-8004 identity registration bond, in wei (0.05 MON).
REGISTRATION_BOND=50000000000000000

# Minimum USDC stake for eligibility (6 decimals → 100e6 = 100 USDC).
MIN_STAKE_USDC=100000000

# Minimum Avaira Score required by the gate.
MIN_SCORE=60

# Deviation challenge window, in seconds (24h).
CHALLENGE_WINDOW=86400

# Anti-spam bond for challengers, in USDC units.
CHALLENGER_BOND_USDC=5000000

# Minimum settled payment that grounds a piece of feedback, in USDC units.
MIN_GROUNDED_PAYMENT=100000

# Credit-market liquidity to seed, in USDC units. Mock USDC only.
SEED_LIQUIDITY_USDC=500000000000

# Settlement token. Leave unset to deploy MockUSDC (testnet); set to native Monad
# USDC on mainnet: 0x754704Bc059F8C67012fEd69BC8A327a5aafb603
USDC=

# ── Sponsor integrations (offchain services) ──────────────────────────────────
# Kimi (Moonshot) — the two-pass adversarial auditor. https://platform.moonshot.ai
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0905-preview

# Privy — passkey agent wallets. https://dashboard.privy.io
PRIVY_APP_ID=
PRIVY_APP_SECRET=
