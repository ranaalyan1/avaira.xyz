REACT_APP_BACKEND_URL=http://localhost:8001
REACT_APP_CHAIN_ID=10143
REACT_APP_EXPLORER_URL=https://testnet.monadscan.com
REACT_APP_MONAD_RPC=https://testnet-rpc.monad.xyz

# ── Deployed contracts (Monad testnet 10143) ────────────────────────────────────
# Prefer reading these from backend/deployments/10143.json when the backend is up.
REACT_APP_INTENT_VAULT=
REACT_APP_IDENTITY_REGISTRY=
REACT_APP_STAKE_REGISTRY=
REACT_APP_CREDIT_MARKET=
REACT_APP_SETTLEMENT_TOKEN=
REACT_APP_COMPLIANCE_GATE=
REACT_APP_CVA_TOKEN=
REACT_APP_AGENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_EXECUTION_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_FREEZE_SLASH_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_REPUTATION_ENGINE_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_INSURANCE_POOL_ADDRESS=0x0000000000000000000000000000000000000000

# ── Workstream 2 — Dynamic embedded wallets (docs.dynamic.xyz) ──────────────────
# Environment ID from the Dynamic dashboard. Leave empty to disable Dynamic entirely:
# the app then renders static fallbacks instead of embedded-wallet onboarding.
REACT_APP_DYNAMIC_ENV_ID=

# ── Workstream 1 — Cleanverse CVI service (services/cvi) ────────────────────────
REACT_APP_CVI_SERVICE_URL=
# How far back the Compliance page scans for CVATransferGated / CVIRequirementChecked
REACT_APP_LOG_WINDOW=20000
REACT_APP_DEPLOYMENT_BLOCK=0

WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
