REACT_APP_BACKEND_URL=http://localhost:8001
REACT_APP_CHAIN_ID=43113
REACT_APP_EXPLORER_URL=https://testnet.snowtrace.io

# Deployed contracts
REACT_APP_AGENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_EXECUTION_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_FREEZE_SLASH_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_REPUTATION_ENGINE_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_INSURANCE_POOL_ADDRESS=0x0000000000000000000000000000000000000000

WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false

# ── Workstream 2: Dynamic (docs.dynamic.xyz) ──────────────────────────────────
# Dynamic environment id — enables Dynamic auth + embedded wallets (operator and
# underwriter roles). Leave unset to run without Dynamic; the app degrades gracefully.
# Find it in the Dynamic dashboard (https://app.dynamic.xyz) → Developers → Environments.
REACT_APP_DYNAMIC_ENV_ID=

# Monad RPC override (defaults to the public testnet endpoint, chain id 10143).
REACT_APP_MONAD_RPC=https://testnet-rpc.monad.xyz

# CVI verification service (services/cvi) used by the Compliance page.
REACT_APP_CVI_SERVICE_URL=http://localhost:8301
