# Avaira frontend — environment variables
#
# ── Read by the SPA ─────────────────────────────────────────────────────────────
# This is the ONLY variable the app reads (frontend/src/lib/api.js). Everything
# else in this file is inert until a component consumes it — setting it changes
# nothing in the deployed UI, so do not add a var here expecting an effect
# without wiring it up first.
#
# Unset → the app calls `${window.location.origin}/api`. On a static Vercel deploy
# that means every public page renders, the sign-in page explains that no API is
# attached, and authenticated dashboard calls 404.
REACT_APP_BACKEND_URL=http://localhost:8001

# ── NOT read by the SPA (reference only) ────────────────────────────────────────
# Kept so the values run at deployment are documented in one place. The deployed
# addresses for a chain live in deployments/{chainId}.json — that file is written
# by `make deploy-robinhood` and checked by `make verify-robinhood`, so it is the source of
# truth; the SDK reads it via `loadDeployment(chainId)`. If a component ever needs
# these, read them from the manifest at build time rather than duplicating them here.
REACT_APP_CHAIN_ID=43113
REACT_APP_EXPLORER_URL=https://testnet.snowtrace.io
REACT_APP_AGENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_EXECUTION_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_FREEZE_SLASH_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_REPUTATION_ENGINE_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_INSURANCE_POOL_ADDRESS=0x0000000000000000000000000000000000000000

# Dev-server only; set by the CRA dev server when tunnelled.
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
