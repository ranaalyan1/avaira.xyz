# React 19 is paired with a few dependencies that still declare React <=18
# peers (react-day-picker@8, parts of Radix, react-scripts@5). Without this,
# `npm ci` / `npm install` aborts with ERESOLVE — which is exactly what a
# Vercel build does on a clean checkout, so the flag has to live in the repo
# rather than in a CI-only command line.
legacy-peer-deps=true

# Keep the engine/runtime noise out of build logs.
fund=false
audit=false
