# ── Avaira CVI service ──────────────────────────────────────────────────────────────────
# Copy to contracts/.env (the service reads it) or export directly. NEVER commit real keys.

# Cleanverse CCP credentials (https://codedocs.cleanverse.com — CCP Integration Guide)
CLEANVERSE_APP_ID=
CLEANVERSE_API_KEY=
CLEANVERSE_BASE_URL=https://api.cleanverse.com
# Override when the CCP route differs from the default in the integration guide
CLEANVERSE_VERIFY_PATH=/v1/identity/verify

# Set to 1 to force deterministic offline decisions (demos, CI, no credentials)
CLEANVERSE_MOCK=1

# Issuer signer: the address must be authorised on the compliance gate (setIssuer)
CLEANVERSE_ISSUER_PRIVATE_KEY=
# Optional separate submitter (defaults to the issuer key); verifyCVI is permissionless
CVI_SUBMITTER_PRIVATE_KEY=

# Deployment
AVAIRA_DEPLOYMENT=../../deployments/10143.json
AVAIRA_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
CLEANVERSE_COMPLIANCE_GATE=
CLEANVERSE_CVA_TOKEN=

# Credential policy
CVI_VALIDITY_SECONDS=31536000
# When 1, the CCP expiry is carried on-chain via verifyCVIWithExpiry
CVI_ISSUER_EXPIRY=0

# HTTP
CVI_HOST=0.0.0.0
CVI_PORT=8403
