# ── Avaira CVI verification service ───────────────────────────────────────────
# Copy to .env and fill in. Never commit real values.

# AvairaComplianceGate address on the target chain (or set AVAIRA_DEPLOYMENT to a
# deployments/{chainId}.json manifest that contains complianceGate).
GATE_ADDRESS=
# AVAIRA_DEPLOYMENT=../../deployments/10143.json

# Cleanverse issuer key — signs CVI credentials exactly as AvairaComplianceGate
# verifies them (EIP-191 over wallet ‖ credentialHash ‖ expiry).
ISSUER_PRIVATE_KEY=0x_your_issuer_key

# Chain settings (Monad Testnet defaults)
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
# Cleanverse chain identifier sent to the CCP API
CHAIN_NAME=monad

# Cleanverse CCP credentials (https://codedocs.cleanverse.com — CCP Integration Guide).
# The API key is used as the AES-256-CBC key locally and is NEVER transmitted;
# only CLEANVERSE_APP_ID travels, as the `api-id` header.
CLEANVERSE_APP_ID=
CLEANVERSE_API_KEY=
# CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate

# Offline demo/CI mode: 1 = deterministic mock CCP, no external calls.
CLEANVERSE_MOCK=0
# Comma-separated wallets the mock CCP reports as unverified (demo convenience).
CLEANVERSE_MOCK_REJECT=

# CVI credential lifetime in seconds (default 30 days).
CREDENTIAL_TTL_SECONDS=2592000

PORT=8301
