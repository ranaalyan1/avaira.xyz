  },
  "dependencies": {
    "@avaira/sdk": "file:../../sdk/typescript",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
