# ── Avaira-gated Perpl grid bot (services/perpl-bot) ───────────────────────────
# Perpl DEX (docs.perpl.xyz/resources/for-developers, github.com/PerplFoundation/dex-sdk)
PERPL_API_URL=https://api.perpl.xyz
PERPL_API_KEY=
# Market to quote: the deepest pair by default
PERPL_PAIR=MON/USDC
# 1 = deterministic offline exchange (no network, no funds). Leave 0 for live.
PERPL_MOCK=1

# Strategy
GRID_LEVELS=5
GRID_SPACING_BPS=25
ORDER_SIZE_USD=25
MAX_POSITION_USD=500
MAX_DRAWDOWN_USD=150
MIN_SCORE=60
CYCLE_SECONDS=60
GAS_BUFFER_USD=2

# Avaira gate
AVAIRA_DEPLOYMENT=../../deployments/10143.json
AVAIRA_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
AGENT_ID=1
AVAIRA_AGENT_PRIVATE_KEY=

# Persistence + telemetry
STATE_FILE=./state/bot-state.json
JOURNAL_FILE=./state/journal.jsonl
BOT_HOST=0.0.0.0
BOT_PORT=8404
