# ── Perpl trading bot (Workstream 3) ─────────────────────────────────────────
# Every cycle runs through avaira.run() with a RiskEnvelope; secrets only here.

# Chain / deployment
CHAIN_ID=10143
PERPL_RPC_URL=http://127.0.0.1:8545              # local anvil; https://testnet-rpc.monad.xyz for testnet
PERPL_DEPLOYMENT=                                # optional explicit manifest path (else $AVAIRA_DEPLOYMENT / deployments/{chainId}.json)

# Operator key: pays gas + registration bond, signs commitIntent/attestOutcome.
# NEVER commit a funded key; the anvil test key below is public and worthless.
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Agent identity
PERPL_AGENT_ID=                                  # leave empty to auto-provision (register+stake+score)
PERPL_AUTO_PROVISION=1

# Exchange
PERPL_MODE=sim                                   # sim = offline paper book (default) | live = PERPL_API_URL
PERPL_PAIR=MON/USDC
PERPL_API_URL=                                   # live mode only
PERPL_API_KEY=                                   # live mode only

# Strategy + risk
PERPL_CYCLE_MS=15000                             # cycle interval
PERPL_CYCLE_BUDGET_USD=250                       # RiskEnvelope.maxSpendUsd per cycle (gas reserve deducted)
PERPL_STARTING_CAPITAL_USD=1000                  # capital base for equity + drawdown kill switch
PERPL_GRID_LEVELS=2
PERPL_GRID_SPREAD_BPS=30
PERPL_ORDER_SIZE_MON=2
PERPL_MAX_POSITION_QTY=20                        # hard inventory cap (base units)
PERPL_MAX_DRAWDOWN_PCT=10                        # kill switch threshold vs equity peak
PERPL_MIN_SCORE=60                               # Avaira Score floor (gate enforces on-chain too)
PERPL_MON_USD=1                                  # reference price for sim fills + gas budgeting
PERPL_GAS_RESERVE_USD=0.5                        # minimum gas reserve deducted from the cycle budget

# Telemetry + persistence
PORT=8401
PERPL_STATE_FILE=                                # default: services/perpl-bot/data/state.json
PERPL_MAX_CYCLES=                                # stop after N cycles (testing)
PERPL_FORCE_BLOCK=0                              # 1 = next cycle is intentionally blocked by the gate
