# ── Qwen treasury agent (Workstream 4) ───────────────────────────────────────

# DashScope OpenAI-compatible endpoint. When QWEN_API_KEY is unset the agent
# runs in QWEN_MOCK=1 mode (deterministic scripted responses) so the demo is
# reproducible offline / in CI.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_MOCK=                                       # force mock mode even with a key (1/0)

# Chain / deployment
CHAIN_ID=10143
QWEN_RPC_URL=http://127.0.0.1:8545               # local anvil; https://testnet-rpc.monad.xyz for testnet
QWEN_DEPLOYMENT=                                 # optional manifest path (else $AVAIRA_DEPLOYMENT)

# Operator key: registers/stakes/scores the treasury agent, pays gas, signs
# commitIntent/attestOutcome. NEVER commit a funded key.
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Challenger key for the deviation scenario (bounty recipient). Defaults to anvil account #3.
CHALLENGER_PRIVATE_KEY=0x92db14e403b83dfe3df233f83dfa3a0d7096f21ca9b0d6d6b8d88b2b406d2892

QWEN_AGENT_ID=                                   # leave empty to auto-provision
QWEN_TASK_BUDGET_USD=500                         # task-budget RiskEnvelope maxSpendUsd
QWEN_TASK_WINDOW_SEC=600                         # envelope deadline horizon per tool call
