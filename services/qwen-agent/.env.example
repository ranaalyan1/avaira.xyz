# ── Qwen-powered Avaira agent (services/qwen-agent) ────────────────────────────
# Alibaba Cloud DashScope, OpenAI-compatible endpoint.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
# 1 forces the deterministic offline planner (no LLM, no network). Auto-on without a key.
QWEN_MOCK=

# Treasury task
TREASURY_TASK="Rebalance 4000 USDC of the settlement reserve into the yield sleeve without exceeding the cycle budget"
TREASURY_BUDGET_USD=5000
MAX_STEPS=6

# Avaira gate
AVAIRA_DEPLOYMENT=../../deployments/10143.json
AVAIRA_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
AGENT_ID=1
AVAIRA_AGENT_PRIVATE_KEY=

# Evidence
TRANSCRIPT_DIR=./transcripts
